{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/custom-navigation-voice-generator/corpus.schema.json",
  "type": "object",
  "required": ["version", "phrases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "metadata_notes": { "type": "object" },
    "phrases": {
      "type": "array",
      "items": { "$ref": "#/definitions/phrase" }
    }
  },
  "definitions": {
    "phrase": {
      "type": "object",
      "required": ["id", "category", "language", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "category": {
          "type": "string",
          "enum": ["directions", "distances", "traffic", "enforcement", "arrival", "language_tests"]
        },
        "language": { "type": "string", "enum": ["ne", "en", "ne-en"] },
        "text": { "type": "string", "minLength": 1 },
        "tts_text": { "type": ["string", "null"] },
        "expected_pronunciation": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "review_status": { "type": "string", "enum": ["draft", "needs-review", "approved"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
